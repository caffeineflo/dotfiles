#!/usr/bin/env bash

# Preferences read from the source Mac on 2026-10-02 (111 keys).
# Only keys from the existing macOS recipes and Finder view settings are captured.
# This recipe is separate from bootstrap. Quit affected apps before applying it.

set -o errexit
set -o pipefail
set -o nounset
set -o noglob
set -o noclobber
set -o posix

case "${1:---help}" in
	--apply) ;;
	--help|-h)
		printf '%s\n' \
			'Usage: bash .macos --apply' \
			'Restore 111 captured preference keys, backing up affected domains first.' \
			'Quit affected apps before applying; log out afterward to reload preferences.'
		exit
		;;
	*) printf '%s\n' 'Usage: bash .macos --apply' >&2; exit 2 ;;
esac
if [ "$#" -ne 1 ]; then
	printf '%s\n' 'Usage: bash .macos --apply' >&2
	exit 2
fi

umask 077
state_dir="${HOME}/.dotfiles-backups"
mkdir -p -- "$state_dir"
backup_dir=$(mktemp -d "${state_dir}/macos-$(date +%Y%m%dT%H%M%S).XXXXXX")
stored_domains=$(defaults domains | tr '[:upper:]' '[:lower:]')
stored_domains=",${stored_domains//, /,},"
for domain in \
	NSGlobalDomain \
	com.apple.print.PrintingPrefs \
	com.apple.LaunchServices \
	com.apple.systempreferences \
	com.apple.driver.AppleBluetoothMultitouch.trackpad \
	com.apple.BluetoothAudioAgent \
	com.apple.screencapture \
	com.apple.finder \
	com.apple.desktopservices \
	com.apple.frameworks.diskimages \
	com.apple.NetworkBrowser \
	com.apple.dock \
	com.apple.dashboard \
	com.apple.Safari \
	com.apple.Spotlight \
	com.apple.Terminal \
	com.googlecode.iterm2 \
	com.apple.TimeMachine \
	com.apple.ActivityMonitor \
	com.apple.AddressBook \
	com.apple.iCal \
	com.apple.DiskUtility \
	com.apple.AppStore \
	com.apple.SoftwareUpdate \
	com.apple.commerce \
	com.apple.messageshelper.MessageController \
	com.google.Chrome \
	com.google.Chrome.canary; do
	domain_lower=$(printf '%s' "$domain" | tr '[:upper:]' '[:lower:]')
	if [ "$domain" = NSGlobalDomain ] || [[ "$stored_domains" = *",${domain_lower},"* ]]; then
		defaults export "$domain" "${backup_dir}/${domain}.plist"
	else
		printf 'No existing defaults domain to back up: %s\n' "$domain" >&2
	fi
done
stored_host_domains=$(defaults -currentHost domains | tr '[:upper:]' '[:lower:]')
stored_host_domains=",${stored_host_domains//, /,},"
if current_host_global=$(defaults -currentHost read NSGlobalDomain 2>&1); then
	defaults -currentHost export NSGlobalDomain "${backup_dir}/currentHost-NSGlobalDomain.plist"
elif [[ "$current_host_global" = *"does not exist"* ]]; then
	printf '%s\n' 'No existing current-host global defaults to back up.' >&2
else
	printf 'Cannot read current-host global defaults: %s\n' "$current_host_global" >&2
	exit 1
fi
if [[ "$stored_host_domains" = *",com.apple.imagecapture,"* ]]; then
	defaults -currentHost export com.apple.ImageCapture "${backup_dir}/currentHost-com.apple.ImageCapture.plist"
else
	printf '%s\n' 'No existing current-host defaults domain to back up: com.apple.ImageCapture' >&2
fi
printf 'Preference backups: %s\n' "$backup_dir"


# NSGlobalDomain
defaults write NSGlobalDomain AppleShowScrollBars -string Always
defaults write NSGlobalDomain NSWindowResizeTime -float 0.0010000000474974513
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true
defaults write NSGlobalDomain NSTextShowsControlCharacters -bool true
defaults write NSGlobalDomain NSDisableAutomaticTermination -bool true
defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false
defaults write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
defaults write NSGlobalDomain com.apple.swipescrolldirection -bool false
defaults write NSGlobalDomain AppleKeyboardUIMode -int 3
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool true
defaults write NSGlobalDomain AppleLanguages '<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<array>
	<string>en</string>
	<string>de</string>
</array>
</plist>
'
defaults write NSGlobalDomain AppleLocale -string en_US@currency=usd
defaults write NSGlobalDomain AppleMeasurementUnits -string Centimeters
defaults write NSGlobalDomain AppleMetricUnits -bool true
defaults write NSGlobalDomain AppleFontSmoothing -int 1
defaults write NSGlobalDomain AppleShowAllExtensions -bool true
defaults write NSGlobalDomain com.apple.springing.enabled -bool true
defaults write NSGlobalDomain com.apple.springing.delay -float 0.0
defaults write NSGlobalDomain WebKitDeveloperExtras -bool true
defaults write NSGlobalDomain KeyRepeat -int 6
defaults write NSGlobalDomain InitialKeyRepeat -int 25

# com.apple.print.PrintingPrefs
defaults write com.apple.print.PrintingPrefs 'Quit When Finished' -bool true

# com.apple.LaunchServices
defaults write com.apple.LaunchServices LSQuarantine -bool false

# com.apple.systempreferences
defaults write com.apple.systempreferences NSQuitAlwaysKeepsWindows -bool false

# com.apple.driver.AppleBluetoothMultitouch.trackpad
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true

# NSGlobalDomain (current host)
